<?xml version="1.0" encoding="UTF-8"?>
<pythonPanelDocument>
  <!-- Penstroke font browser. Auto-registered: the package puts
       $PENSTROKE/houdini on HOUDINI_PATH, and Houdini scans
       python_panels/*.pypanel there. Open via the Python Panel pane
       tab menu > Penstroke Fonts. Drives the fontidx of the selected
       penstroke::text_layout node, so it stays in sync with the
       node's own Font slider. -->
  <interface name="penstroke_fonts" label="Penstroke Fonts"
             icon="SOP_font" showNetworkNavigationBar="false"
             help_url="">
    <script><![CDATA[
import os
import hou
from hutil.Qt import QtCore, QtGui, QtWidgets

TL_TYPE = 'penstroke::text_layout'


def _target():
    """The penstroke::text_layout node to drive: a selected one, else
    the single instance in the scene if unambiguous."""
    sel = [n for n in hou.selectedNodes()
           if n.type().name().startswith(TL_TYPE)]
    if sel:
        return sel[0]
    try:
        alln = hou.nodeType(hou.sopNodeTypeCategory(),
                            TL_TYPE).instances()
    except Exception:
        alln = []
    return alln[0] if len(alln) == 1 else None


class FontPanel(QtWidgets.QWidget):
    def __init__(self):
        QtWidgets.QWidget.__init__(self)
        self._bundles = []          # full sorted list of bundle paths
        self._node = None

        root = QtWidgets.QVBoxLayout(self)
        root.setContentsMargins(6, 6, 6, 6)

        self._hdr = QtWidgets.QLabel()
        self._hdr.setWordWrap(True)
        root.addWidget(self._hdr)

        row = QtWidgets.QHBoxLayout()
        self._search = QtWidgets.QLineEdit()
        self._search.setPlaceholderText('Filter fonts…')
        self._search.setClearButtonEnabled(True)
        reload_btn = QtWidgets.QPushButton('Reload')
        reload_btn.setToolTip('Re-read the selected node and its folder')
        row.addWidget(self._search)
        row.addWidget(reload_btn)
        root.addLayout(row)

        self._list = QtWidgets.QListWidget()
        self._list.setUniformItemSizes(True)
        root.addWidget(self._list, 1)

        # Glyph preview (the bundle's QA contact sheet).
        self._preview = QtWidgets.QLabel()
        self._preview.setAlignment(QtCore.Qt.AlignCenter)
        self._preview.setMinimumHeight(150)
        self._preview.setFrameShape(QtWidgets.QFrame.StyledPanel)
        root.addWidget(self._preview)

        self._search.textChanged.connect(self._refilter)
        # currentItemChanged fires on arrow-key navigation too -> live.
        self._list.currentItemChanged.connect(self._pick)
        reload_btn.clicked.connect(self.reload)

        self.reload()

    # -- data ----------------------------------------------------------
    def reload(self):
        from penstroke import hfont
        self._node = _target()
        if self._node is None:
            self._hdr.setText('Select a <b>%s</b> node, then Reload.'
                              % TL_TYPE)
            self._list.clear()
            self._bundles = []
            return
        folder = self._node.evalParm('hfont')
        self._bundles = hfont.list_bundles(folder)
        self._hdr.setText('Driving <b>%s</b> &nbsp; — &nbsp; %d fonts in '
                          '%s' % (self._node.path(), len(self._bundles),
                                  os.path.basename(folder.rstrip('/\\'))))
        self._list.blockSignals(True)
        self._list.clear()
        for i, b in enumerate(self._bundles):
            name = os.path.basename(b)
            it = QtWidgets.QListWidgetItem(
                name[:-6] if name.endswith('.hfont') else name)
            it.setData(QtCore.Qt.UserRole, i)
            self._list.addItem(it)
        self._list.blockSignals(False)
        # Highlight the node's current font.
        cur = int(self._node.evalParm('fontidx'))
        if 0 <= cur < self._list.count():
            self._list.setCurrentRow(cur)
        self._refilter(self._search.text())

    # -- interactions --------------------------------------------------
    def _refilter(self, text):
        t = text.strip().lower()
        for r in range(self._list.count()):
            it = self._list.item(r)
            it.setHidden(bool(t) and t not in it.text().lower())

    def _pick(self, item, _prev=None):
        if item is None or self._node is None:
            return
        idx = item.data(QtCore.Qt.UserRole)
        try:
            self._node.parm('fontidx').set(int(idx))   # live update
        except hou.OperationFailed:
            return
        self._show_preview(self._bundles[idx])

    def _show_preview(self, bundle):
        png = None
        for rep in ('strokes_bezier', 'strokes', 'outline'):
            p = os.path.join(bundle, 'qa', rep + '.png')
            if os.path.exists(p):
                png = p
                break
        if not png:
            self._preview.setText('(no QA preview)')
            return
        pix = QtGui.QPixmap(png)
        if not pix.isNull():
            self._preview.setPixmap(pix.scaled(
                self._preview.width(), self._preview.height(),
                QtCore.Qt.KeepAspectRatio, QtCore.Qt.SmoothTransformation))


def createInterface():
    return FontPanel()
]]></script>
  </interface>
</pythonPanelDocument>
